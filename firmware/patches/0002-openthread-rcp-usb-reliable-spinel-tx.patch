--- a/components/openthread/src/port/esp_openthread_uart.c
+++ b/components/openthread/src/port/esp_openthread_uart.c
@@ -27,6 +27,13 @@
 #include "driver/usb_serial_jtag.h"
 #if CONFIG_OPENTHREAD_RCP_USB_SERIAL_JTAG
 #include "hal/usb_serial_jtag_ll.h"
+#include "freertos/FreeRTOS.h"
+
+// The OpenThread mainloop runs in the task that sends, so the wait for room in the TX ring buffer is bounded.
+#define ESP_OPENTHREAD_USB_TX_TIMEOUT_MS 100
+// usb_serial_jtag_write_bytes() queues a frame whole or not at all, so the ring buffers must hold the largest
+// spinel frame: a 127-byte PSDU plus spinel header and metadata, doubled by worst-case HDLC escaping.
+#define ESP_OPENTHREAD_USB_MIN_BUFFER_SIZE 1024
 #endif
 
 static int s_uart_port;
@@ -53,11 +60,19 @@
 
 otError otPlatUartSend(const uint8_t *buf, uint16_t buf_length)
 {
-    int rval = write(s_uart_fd, buf, buf_length);
-
-    // DIG-727
 #if CONFIG_OPENTHREAD_RCP_USB_SERIAL_JTAG
+    // Not write(): the console VFS copies byte by byte, drops the rest once the host stops draining and still
+    // reports the full length, which truncates a spinel frame mid-flight. The driver call queues the frame whole
+    // or not at all, and its interrupt handler moves it to the FIFO.
+    int rval = usb_serial_jtag_write_bytes(buf, buf_length, pdMS_TO_TICKS(ESP_OPENTHREAD_USB_TX_TIMEOUT_MS));
+
+    // Keep the flush (DIG-727). The driver only sends from its "FIFO empty" interrupt, and that interrupt is
+    // lost when boot output filled the FIFO before the host enumerated the port: the bus reset empties the
+    // FIFO without raising it. The flush sends a packet, the interrupt fires on completion and transmission
+    // resumes. Without it a radio that was powered on cold never sends anything.
     usb_serial_jtag_ll_txfifo_flush();
+#else
+    int rval = write(s_uart_fd, buf, buf_length);
 #endif
 
     otPlatUartSendDone();
@@ -154,7 +169,14 @@
     usb_serial_jtag_vfs_set_rx_line_endings(ESP_LINE_ENDINGS_LF);
     usb_serial_jtag_vfs_set_tx_line_endings(ESP_LINE_ENDINGS_LF);
 
-    ESP_ERROR_CHECK(usb_serial_jtag_driver_install((usb_serial_jtag_driver_config_t *)&config->host_config.host_usb_config));
+    usb_serial_jtag_driver_config_t usb_config = config->host_config.host_usb_config;
+    if (usb_config.tx_buffer_size < ESP_OPENTHREAD_USB_MIN_BUFFER_SIZE) {
+        usb_config.tx_buffer_size = ESP_OPENTHREAD_USB_MIN_BUFFER_SIZE;
+    }
+    if (usb_config.rx_buffer_size < ESP_OPENTHREAD_USB_MIN_BUFFER_SIZE) {
+        usb_config.rx_buffer_size = ESP_OPENTHREAD_USB_MIN_BUFFER_SIZE;
+    }
+    ESP_ERROR_CHECK(usb_serial_jtag_driver_install(&usb_config));
     ESP_ERROR_CHECK(usb_serial_jtag_vfs_register());
     usb_serial_jtag_vfs_use_driver();
 
